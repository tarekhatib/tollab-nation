generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Variable names match what Neon's Vercel integration creates, so nothing has to be copied by hand.
  // Pooled connection for the app (Neon adds pgbouncer=true for Prisma).
  url       = env("POSTGRES_PRISMA_URL")
  // Direct connection for migrations (the pooler can't hold Prisma's migration lock).
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[]
}

model Article {
  id          Int           @id @default(autoincrement())
  title       String
  slug        String        @unique
  content     Json
  coverImage  String?
  isFeatured  Boolean       @default(false)
  views       Int           @default(0)
  publishedAt DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  categoryId  Int
  clicks      Int           @default(0)
  isDraft     Boolean       @default(false)
  titleAr     String        @default("")
  authorId    Int?
  ads         AdOnArticle[]
  category    Category      @relation(fields: [categoryId], references: [id])
  author      Author?       @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([authorId])
  @@index([publishedAt])
}

/// A writer credited on articles. With no avatarUrl the site shows the default avatar.
model Author {
  id         Int       @id @default(autoincrement())
  name       String
  slug       String    @unique
  avatarUrl  String?
  bio        String    @default("")
  isVerified Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  articles   Article[]
}

model Ad {
  id        Int           @id @default(autoincrement())
  imageUrl  String
  linkUrl   String
  text      String?
  showOnAll Boolean       @default(true)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  position  Int           @default(2)
  expiresAt DateTime?
  articles  AdOnArticle[]

  @@index([position])
}

model AdOnArticle {
  adId      Int
  articleId Int
  ad        Ad      @relation(fields: [adId], references: [id], onDelete: Cascade)
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([adId, articleId])
}

model QuickUpdate {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  textEn     String
  textAr     String
  isBreaking Boolean  @default(false)

  @@index([createdAt])
}
