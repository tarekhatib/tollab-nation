# ── Required ────────────────────────────────────────────────
# Postgres connection string (Neon: use the pooled URL)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Session signing secret — generate with: openssl rand -base64 32
AUTH_SECRET="generate-a-long-random-secret"
# The single admin login for /admin
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"

# ── Optional ────────────────────────────────────────────────
# Public URL of the site (used in links and metadata)
NEXT_PUBLIC_SITE_URL="https://tollabnation.com"
# Image uploads from the admin (unsigned upload preset). Without these, paste image URLs instead.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_UPLOAD_PRESET=""
# Contact form email delivery (resend.com)
RESEND_API_KEY=""
# Protects /api/cron/* endpoints (sent as "Authorization: Bearer <secret>")
CRON_SECRET="generate-another-random-secret"
# Image proxy for non-Cloudinary images; set to "off" to serve originals
NEXT_PUBLIC_IMAGE_PROXY=""
