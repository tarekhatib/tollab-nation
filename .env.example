# ─────────────────────────────────────────────────────────────
# Tollab Nation — environment variables
#
# Local:  cp .env.example .env  and fill it in.
# Vercel: add the same keys in Project → Settings → Environment Variables
#         (tick Production + Preview). Redeploy after changing them.
#
# Hosting map (all free tiers):
#   Vercel     → the whole app: pages, API routes, admin, cron
#   Neon       → Postgres database
#   Vercel Blob → image uploads (resizing via the free wsrv.nl proxy)
#   Resend     → contact-form email
# ─────────────────────────────────────────────────────────────


# ── Database · Neon ──────────────────────────────────────────  REQUIRED
# neon.tech → your project → Dashboard → "Connect" → choose the POOLED
# connection (host contains "-pooler") → copy the postgresql:// string.
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Same string WITHOUT "-pooler" (Neon: untick "Connection pooling" in the Connect dialog).
# Used only to run migrations, which happen automatically on every Vercel build.
# Connecting Neon from Vercel's Storage tab creates both of these (plus some unused PG*/POSTGRES_* extras).
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"


# ── Auth · Auth.js ───────────────────────────────────────────  REQUIRED
# Random secret that signs admin sessions. Generate one:
#   openssl rand -base64 32
# Changing it signs everyone out.
AUTH_SECRET=""

# The single admin login for /admin/login. Pick a strong password.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""


# ── Images · Vercel Blob ─────────────────────────────────────  RECOMMENDED
# Needed to upload images from the admin (otherwise paste image links).
# Vercel → your project → Storage → Create → Blob → connect to the project.
# Vercel adds this token automatically; copy it here for local development
# (Storage → your Blob store → .env.local tab, or run `vercel env pull`).
BLOB_READ_WRITE_TOKEN=""


# ── Contact form email · Resend ──────────────────────────────  OPTIONAL
# resend.com → API Keys → Create API key (Sending access).
# Without it the contact form shows "temporarily unavailable".
RESEND_API_KEY=""
# Where contact messages go. With the default sender below, Resend only
# delivers to the email address your Resend account was created with.
CONTACT_EMAIL_TO="tollabcontact@gmail.com"
# Sender. Leave empty to use Resend's test sender (onboarding@resend.dev).
# After verifying your own domain in Resend → Domains, use e.g.
#   "Tollab Nation <contact@yourdomain.com>"
CONTACT_EMAIL_FROM=""


# ── Cron jobs ────────────────────────────────────────────────  RECOMMENDED
# Protects /api/cron/*. Vercel Cron sends it automatically as
# "Authorization: Bearer <CRON_SECRET>" (schedule lives in vercel.json:
# daily clean-up of live updates older than 48h).
# Generate: openssl rand -hex 32
CRON_SECRET=""


# ── Site ─────────────────────────────────────────────────────  OPTIONAL
# Public URL used in canonical links, the sitemap and share previews.
# Leave empty on Vercel to use the project's production URL automatically;
# set it once you attach a custom domain, e.g. "https://tollabn.com".
NEXT_PUBLIC_SITE_URL=""

# Remote images are resized through wsrv.nl (free). Set to "off" to serve originals.
NEXT_PUBLIC_IMAGE_PROXY=""

# Key the WhatsApp listener sends to POST /api/updates/ingest. Generate: openssl rand -hex 32
INGEST_SECRET=
