# Your live site, no trailing slash
SITE_URL=https://your-site.com
# Must match INGEST_SECRET in Vercel → Project → Settings → Environment Variables
INGEST_SECRET=
# The channel's public link (WhatsApp › Channel › Share)
CHANNEL_LINK=https://whatsapp.com/channel/XXXXXXXXXXXXXXXXXXXXXX
# The listener number with country code, digits only (used by `npm run pair`)

PAIR_PHONE=
# Optional: how often to double-check for missed posts (seconds)
POLL_SECONDS=60
# Optional: a free healthchecks.io ping URL that emails you if the listener stops
HEARTBEAT_URL=
